{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpssportal",
  "main": "custom-worker.mjs",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kpssportal"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kamu_bildirim_sepeti",
      "database_id": "37ec183a-11be-4a6c-b0fd-caa2039677f7",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}
