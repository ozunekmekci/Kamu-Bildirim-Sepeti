# Kamu Bildirim Sepeti - Ornek Ortam Degiskenleri (Faz 1-4)
# Bu dosyayi yerel gelistirme icin .env.local olarak kopyalayin veya
# canli ortamda `npx wrangler secret put <ANAHTAR>` ile tanimlayin.
# Hicbir gercek gizli anahtari bu dosyaya yazmayin.

# --- Uygulama ve Guvenlik ---
# Sitenin kanonik temel adresi (sitemap, e-posta baglantilari ve odeme yonlendirmeleri icin)
NEXT_PUBLIC_SITE_URL=https://kamubildirimsepeti.com
# Oturum token imzalama anahtari (uretimde en az 32 rastgele bayt onerilir)
SESSION_SECRET=
# Zamanlanmis senkronizasyon (/api/cron/sync) Bearer gizli anahtari
CRON_SECRET=

# --- E-posta Gonderim Saglayicilari ---
# Resend API anahtari (tanimliysa otomatik olarak Resend secilir)
RESEND_API_KEY=
# MailChannels API anahtari (Cloudflare Workers alternatifi)
MAILCHANNELS_API_KEY=
# Gonderici e-posta adresi
EMAIL_FROM=bildirim@kamubildirimsepeti.com

# --- Odeme Saglayicilari (demo | stripe | iyzico) ---
# Bos birakilirsa tanimli anahtarlara gore secilir; yoksa demo modunda calisir
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_WEBHOOK_SECRET=

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Tarayici Anlik Bildirimleri (Web Push / VAPID) ---
# Anahtar cifti uretmek icin: bash scripts/setup-cloudflare.sh --generate-vapid
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:iletisim@kamubildirimsepeti.com
